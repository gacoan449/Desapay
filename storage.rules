rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // =========================================================
    // HELPER
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    // =========================================================
    // KYC
    // =========================================================

    match /kyc/{uid}/{fileName} {

      // User hanya boleh upload file KYC miliknya.
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|application/pdf'
        );

      // User hanya bisa membaca KYC miliknya.
      // Admin bisa membaca semua.
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );
    }


    // =========================================================
    // PROFILE
    // =========================================================

    match /profiles/{uid}/{fileName} {

      allow read: if signedIn();

      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*'
        );
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{allPaths=**} {

      allow read, write: if false;
    }
  }
}
