rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "nama", "name", "displayName", "email", "phone",
          "balance", "poin", "member", "role", "fotoProfil", "fotoKtp",
          "fotoSelfie", "photoUrl", "ktpUrl", "selfieUrl", "kycStatus",
          "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.balance == 0
        && request.resource.data.poin == 0
        && request.resource.data.member == "Silver"
        && request.resource.data.role == "user"
        && request.resource.data.kycStatus == "BELUM"
        && request.resource.data.status == "Aktif"
        && request.resource.data.fotoKtp == ""
        && request.resource.data.fotoSelfie == ""
        && request.resource.data.ktpUrl == ""
        && request.resource.data.selfieUrl == "";
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "displayName", "photoUrl", "phone", "email", "updatedAt",
          "nama", "fotoProfil", "fotoKtp", "fotoSelfie", "ktpUrl", "selfieUrl",
          "securityUpdatedAt", "kycStatus"
        ])
        && (!(resource.data.kycStatus == "Terverifikasi"
          || resource.data.kycStatus == "TERVERIFIKASI"
          || resource.data.kycStatus == "APPROVED")
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "fotoKtp", "fotoSelfie", "ktpUrl", "selfieUrl"
          ]))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["kycStatus"])
          || (request.resource.data.kycStatus == "Pending"
            && resource.data.kycStatus != "Terverifikasi"
            && resource.data.kycStatus != "TERVERIFIKASI"
            && resource.data.kycStatus != "APPROVED"
            && request.resource.data.fotoKtp is string
            && request.resource.data.fotoKtp.size() > 0
            && request.resource.data.fotoSelfie is string
            && request.resource.data.fotoSelfie.size() > 0)));
      allow delete: if isAdmin();
    }

    match /keluhan_pelanggan/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "Pending"
        && request.resource.data.pesan is string
        && request.resource.data.pesan.size() > 0
        && request.resource.data.pesan.size() <= 2000
        && request.resource.data.keys().hasOnly([
          "uid", "namaUser", "phoneUser", "pesan", "status", "waktuMasuk"
        ]);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /transaction_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == "WAITING" && ((request.resource.data.buyer_sku_code is string && request.resource.data.buyer_sku_code.size() > 0) || (request.resource.data.sku is string && request.resource.data.sku.size() > 0)) && request.resource.data.customerNo is string && request.resource.data.customerNo.size() > 0 && request.resource.data.keys().hasOnly(["requestId", "transactionId", "uid", "type", "sku", "buyer_sku_code", "productName", "category", "brand", "customerNo", "customer_no", "operator", "amount", "sellingPrice", "cost", "margin", "paymentMethod", "status", "isTest", "testMode", "digiflazzSent", "source", "categoryScreen", "createdAt", "updatedAt"]);
      allow update, delete: if false;
    }

    match /balance_ledger/{ledgerId} { allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow create, update, delete: if false; }
    match /mutasi_saldo/{mutasiId} { allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow create, update, delete: if false; }
    match /topup_transactions/{transactionId} { allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow create, update, delete: if false; }
    match /transactions/{transactionId} { allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow create, update, delete: if false; }
    match /notifications/{notificationId} { allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); allow create, update, delete: if false; }
    match /notifikasi/{notificationId} { allow read: if isAdmin() || (signedIn() && (resource.data.uid == request.auth.uid || resource.data.uid == "global")); allow create, update, delete: if false; }
    match /products/{productId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /kyc/{uid} { allow read: if isOwner(uid) || isAdmin(); allow create, update, delete: if false; }
    match /promos/{promoId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /settings/{settingId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /devices/{deviceId} { allow read: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /bank_mutations/{mutationId} { allow read: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /announcements/{announcementId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
