rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // HELPER
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      allow read: if isOwner(uid) || isAdmin();


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.balance == 0
        && request.resource.data.poin == 0
        && request.resource.data.member == "Silver"
        && request.resource.data.role == "user";


      // -------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------
      //
      // Admin boleh update.
      //
      // User hanya boleh mengubah field profil non-finansial.
      //
      // -------------------------------------------------------

      allow update: if isAdmin()

        || (
          isOwner(uid)

          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "name",
                "displayName",
                "photoUrl",
                "phone",
                "email",
                "updatedAt"
              ])
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if isAdmin();
    }


    // =========================================================
    // BALANCE LEDGER
    // =========================================================

    match /balance_ledger/{ledgerId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // Hanya backend/Admin SDK.
      allow create, update, delete: if false;
    }


    // =========================================================
    // MUTASI SALDO
    // =========================================================

    match /mutasi_saldo/{mutasiId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if false;
    }


    // =========================================================
    // TOP UP TRANSACTIONS
    // =========================================================

    match /topup_transactions/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if false;
    }


    // =========================================================
    // PPOB TRANSACTIONS
    // =========================================================

    match /transactions/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // Tidak boleh dimanipulasi client.
      allow create, update, delete: if false;
    }


    // =========================================================
    // PRODUCTS
    // =========================================================

    match /products/{productId} {

      // User boleh membaca produk.
      allow read: if signedIn();

      // Perubahan produk hanya admin.
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // KYC
    // =========================================================
    //
    // CATATAN:
    // Sistem Anda sekarang menyimpan KYC di users/{uid}
    // melalui field kycStatus.
    //
    // Collection kyc tetap ditutup kecuali nanti benar-benar
    // digunakan.
    // =========================================================

    match /kyc/{uid} {

      allow read: if isOwner(uid) || isAdmin();

      allow create, update, delete: if false;
    }


    // =========================================================
    // PROMO
    // =========================================================

    match /promos/{promoId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEVICES
    // =========================================================

    match /devices/{deviceId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // BANK MUTATIONS
    // =========================================================

    match /bank_mutations/{mutationId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // ANNOUNCEMENTS
    // =========================================================

    match /announcements/{announcementId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {

      allow read, write: if false;
    }
  }
}
