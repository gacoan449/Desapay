rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isOwner(uid) || isAdmin();


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // Sesuai AuthService:
      //
      // balance = 0
      // poin = 0
      // member = Silver
      //

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.balance == 0
        && request.resource.data.poin == 0
        && request.resource.data.member == "Silver";


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // Admin boleh mengubah data user.
      //
      // User hanya boleh mengubah data profil miliknya.
      //
      // Field finansial / keamanan tidak boleh disentuh user.
      //

      allow update: if isAdmin()

        || (
          isOwner(uid)

          && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny([
                "balance",
                "saldo",
                "poin",
                "member",
                "role",
                "uid",

                "pinHash",
                "pinFailedAttempts",
                "pinLockedUntil",

                "saldoLimit",

                "status",

                "kycReason",
                "kycReviewedAt"
              ])

          // User tidak boleh membuat KYC menjadi
          // APPROVED atau REJECTED.
          //
          // Jika user mengubah kycStatus,
          // nilainya hanya boleh PENDING.
          //
          && (
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(["kycStatus"])

            ||

            request.resource.data.kycStatus == "PENDING"
          )
        );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAdmin();
    }


    // ============================================================
    // PRODUCTS
    // ============================================================

    match /products/{productId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // TRANSACTION REQUESTS
    // ============================================================
    //
    // Untuk kondisi kode sekarang:
    //
    // Flutter membuat transaction_requests.
    //
    // Backend nantinya mengambil request tersebut
    // dan memproses Digiflazz.
    //
    // User TIDAK boleh update setelah dibuat.
    //
    // ============================================================

    match /transaction_requests/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );


      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "WAITING"
        && request.resource.data.digiflazzSent == false
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.sellingPrice is number
        && request.resource.data.sellingPrice > 0
        && request.resource.data.sku is string
        && request.resource.data.customerNo is string;


      allow update, delete: if false;
    }


    // ============================================================
    // FINAL TRANSACTIONS
    // ============================================================

    match /transactions/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // Hanya backend/Admin SDK.
      allow create, update, delete: if false;
    }


    // ============================================================
    // TOP UP TRANSACTIONS
    // ============================================================

    match /topup_transactions/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // Hanya backend.
      allow create, update, delete: if false;
    }


    // ============================================================
    // BALANCE LEDGER
    // ============================================================
    //
    // Catatan perubahan saldo.
    //
    // TIDAK boleh ditulis Flutter.
    //
    // Hanya backend/Admin SDK.
    //

    match /balance_ledger/{ledgerId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if false;
    }


    // ============================================================
    // MUTASI SALDO
    // ============================================================

    match /mutasi_saldo/{mutasiId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if false;
    }


    // ============================================================
    // KYC
    // ============================================================

    match /kyc/{uid} {

      allow read: if isOwner(uid) || isAdmin();


      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == "PENDING";


      allow update: if isAdmin()

        || (
          isOwner(uid)
          && resource.data.status == "PENDING"
          && request.resource.data.status == "PENDING"
        );


      allow delete: if isAdmin();
    }


    // ============================================================
    // PROMOS
    // ============================================================

    match /promos/{promoId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // SETTINGS
    // ============================================================

    match /settings/{settingId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // DEVICES
    // ============================================================

    match /devices/{deviceId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // NOTIFIKASI
    // ============================================================

    match /notifikasi/{notificationId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.uid == request.auth.uid
            || resource.data.uid == "ALL"
          )
        );

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // PENGUMUMAN
    // ============================================================

    match /pengumuman/{announcementId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // KELUHAN PELANGGAN
    // ============================================================

    match /keluhan_pelanggan/{keluhanId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // ============================================================
    // BANK MUTATIONS
    // ============================================================

    match /bank_mutations/{mutationId} {

      allow read: if isAdmin();

      allow create, update, delete: if false;
    }


    // ============================================================
    // LEGACY: PRODUK
    // ============================================================

    match /produk/{productId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // LEGACY: TRANSAKSI
    // ============================================================

    match /transaksi/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if false;
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
